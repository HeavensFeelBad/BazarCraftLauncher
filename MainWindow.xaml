<Window x:Class="BCLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BCLauncher (BazarCraft Launcher)"
        Height="780"
        Width="1280"
        MinHeight="720"
        MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0A0F17"
        AllowsTransparency="True">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#141B27"/>
        <SolidColorBrush x:Key="SoftPanelBrush" Color="#1B2332"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A3444"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A8B2C3"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#20D6AA"/>

        <DropShadowEffect x:Key="PanelShadow"
                          BlurRadius="28"
                          ShadowDepth="0"
                          Opacity="0.32"
                          Color="#000000"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#C8D1DE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#243044"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1B2434"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B8C2D2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1B2634"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#19B98F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#21D6A8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#129875"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#202A3A"/>
            <Setter Property="Foreground" Value="#E8EEF7"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Foreground" Value="#20D6AA"/>
            <Setter Property="Background" Value="#243044"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6"/>
                            <Border x:Name="PART_Track"
                                    CornerRadius="6"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="6"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EAF1FA"/>
            <Setter Property="Background" Value="#172131"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#203249"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#174337"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="68"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1B2332"/>
            <Setter Property="BorderBrush" Value="#313A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Border x:Name="SelectionBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"/>
                            </ToggleButton>
                            <ContentPresenter Opacity="0"
                                              Margin="78,0,44,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="#172131"
                                        BorderBrush="#313A4A"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,6,0,0">
                                    <ScrollViewer MaxHeight="240">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#42516A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#20D6AA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SelectionBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0A0F17"
            BorderBrush="#263243"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="#0E141F"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0">
                    <Border Width="18"
                            Height="18"
                            CornerRadius="4"
                            Background="#28295F"
                            Margin="0,0,10,0">
                        <TextBlock Text="◆"
                                   Foreground="#28E0B4"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Foreground="#EEF3F9"
                               FontSize="15"
                               VerticalAlignment="Center">
                        <Run Text="BCLauncher"/>
                        <Run Text=" (BazarCraft Launcher)" Foreground="#AAB4C3"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,5,12,5">
                    <Button Style="{StaticResource IconButton}"
                            Content="－"
                            Click="MinimizeButton_Click"/>
                    <Button Style="{StaticResource IconButton}"
                            Content="□"
                            Click="MaximizeButton_Click"/>
                    <Button Style="{StaticResource IconButton}"
                            Content="×"
                            FontSize="20"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#0F1621"
                        BorderBrush="#263243"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="18,34,18,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="6,0,0,42">
                            <Grid Width="64"
                                  Height="64"
                                  Margin="0,0,16,0">
                                <Border Background="#19283B"
                                        CornerRadius="10"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45"/>
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock Text="◆"
                                           Foreground="#26D6AA"
                                           FontSize="42"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BCLauncher"
                                           Foreground="White"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="BazarCraft Launcher"
                                           Foreground="#909BAD"
                                           FontSize="13"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <Button x:Name="HomeNavButton"
                                    Style="{StaticResource NavButton}"
                                    Background="#15352F"
                                    Foreground="White"
                                    Click="HomeNavButton_Click">
                                <Grid>
                                    <Border Width="3"
                                            HorizontalAlignment="Left"
                                            Background="#20D6AA"
                                            CornerRadius="2"/>
                                    <Grid Margin="18,0,0,0"
                                          VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⌂"
                                                   Foreground="#2DE6B8"
                                                   FontSize="19"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Главная"
                                                   Grid.Column="1"
                                                   Margin="14,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Button>
                            <Button x:Name="BuildsNavButton"
                                    Style="{StaticResource NavButton}"
                                    Click="BuildsNavButton_Click">
                                <Grid Margin="18,0,0,0"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="▧"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Сборки"
                                               Grid.Column="1"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button x:Name="NewsNavButton"
                                    Style="{StaticResource NavButton}"
                                    Click="NewsNavButton_Click">
                                <Grid Margin="18,0,0,0"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="▤"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Новости"
                                               Grid.Column="1"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button x:Name="SettingsNavButton"
                                    Style="{StaticResource NavButton}"
                                    Click="SettingsNavButton_Click">
                                <Grid Margin="18,0,0,0"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚙"
                                               FontSize="19"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Настройки"
                                               Grid.Column="1"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button x:Name="ProfileNavButton"
                                    Style="{StaticResource NavButton}"
                                    Click="ProfileNavButton_Click">
                                <Grid Margin="18,0,0,0"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="♙"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Профиль"
                                               Grid.Column="1"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button x:Name="AboutNavButton"
                                    Style="{StaticResource NavButton}"
                                    Click="AboutNavButton_Click">
                                <Grid Margin="18,0,0,0"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ⓘ"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="О программе"
                                               Grid.Column="1"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="3"
                                Background="#182131"
                                BorderBrush="#303B4E"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="13"
                                             Height="13"
                                             Fill="#54C72E"
                                             Margin="0,1,10,0"/>
                                    <TextBlock x:Name="SidebarStatusText"
                                               Text="Готов к игре"
                                               Foreground="#F2F6FB"
                                               FontSize="15"/>
                                </StackPanel>
                                <TextBlock Text="Все системы работают"
                                           Foreground="#B3BDCC"
                                           FontSize="14"
                                           Margin="0,12,0,0"/>
                                <TextBlock Text="v1.0.0"
                                           Foreground="#B3BDCC"
                                           FontSize="13"
                                           Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.Background>
                        <ImageBrush ImageSource="/assets/hero-valley.png"
                                    Stretch="UniformToFill"
                                    AlignmentY="Top"
                                    Opacity="0.42"/>
                    </Grid.Background>

                    <Grid Background="#AA0A0F17"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="76"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="HomeView"
                                      Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,0">
                        <Grid Margin="42,30,22,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="760"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        MaxWidth="760"
                                        HorizontalAlignment="Left">
                                <TextBlock Text="Добро пожаловать в"
                                           Foreground="#DDE7F2"
                                           FontSize="24"/>
                                <TextBlock Margin="0,14,0,0"
                                           FontSize="48"
                                           FontWeight="Bold">
                                    <Run Text="BC" Foreground="White"/>
                                    <Run Text="Launcher" Foreground="#23D6AA"/>
                                </TextBlock>
                                <TextBlock Text="BazarCraft Launcher"
                                           Foreground="#9FAABC"
                                           FontSize="20"
                                           Margin="0,6,0,0"/>
                                <TextBlock Text="Выбери сборку, скачай обновления и наслаждайся игрой на сервере BazarCraft!"
                                           Foreground="#C0CAD8"
                                           FontSize="17"
                                           LineHeight="28"
                                           TextWrapping="Wrap"
                                           MaxWidth="640"
                                           Margin="0,18,0,22"/>

                                <Border Background="#B8121925"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="22,18"
                                        Effect="{StaticResource PanelShadow}">
                                    <StackPanel>
                                        <TextBlock Text="Выбор сборки"
                                                   Foreground="#FFFFFF"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,14"/>
                                        <Grid>
                                            <ComboBox x:Name="BuildsComboBox"
                                                      SelectionChanged="BuildsComboBox_SelectionChanged"
                                                      DisplayMemberPath="Name"/>
                                            <Border Width="54"
                                                    Height="48"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Margin="14,0,0,0"
                                                    Background="#29364A"
                                                    CornerRadius="9"
                                                    IsHitTestVisible="False">
                                                <Image Source="/assets/hero-valley.png"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel IsHitTestVisible="False"
                                                        VerticalAlignment="Center"
                                                        Margin="78,0,58,0">
                                                <TextBlock x:Name="SelectedBuildNameText"
                                                           Text="Сборка"
                                                           Foreground="White"
                                                           FontSize="19"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock x:Name="SelectedBuildVersionText"
                                                           Text="Версия не выбрана"
                                                           Foreground="#AAB4C3"
                                                           FontSize="14"
                                                           Margin="0,7,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="⌄"
                                                       IsHitTestVisible="False"
                                                       Foreground="#AAB4C3"
                                                       FontSize="24"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,22,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#B8121925"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="22,18"
                                        Margin="0,22,0,0"
                                        Effect="{StaticResource PanelShadow}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock x:Name="StatusTitleText"
                                                       Text="Готов к установке"
                                                       Foreground="White"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock x:Name="ProgressPercentText"
                                                       Text="0%"
                                                       Foreground="#CDD6E3"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>

                                        <TextBlock x:Name="StatusText"
                                                   Text="Нажми Установить / обновить, чтобы подготовить выбранную сборку."
                                                   Foreground="#B8C2D1"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,14"/>

                                        <ProgressBar x:Name="DownloadProgress"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     ValueChanged="DownloadProgress_ValueChanged"/>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⇩"
                                                           Foreground="#20D6AA"
                                                           FontSize="20"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock x:Name="SpeedText"
                                                           Text="Скорость: ожидание"
                                                           Foreground="#AEB8C8"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="◴"
                                                           Foreground="#20D6AA"
                                                           FontSize="18"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock x:Name="TimeLeftText"
                                                           Text="Осталось: --:--"
                                                           Foreground="#AEB8C8"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="▧"
                                                           Foreground="#BFD1E5"
                                                           FontSize="18"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock x:Name="FilesText"
                                                           Text="Файлов: --"
                                                           Foreground="#AEB8C8"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </Grid>
                        </ScrollViewer>

                        <ScrollViewer x:Name="BuildsView"
                                      Grid.Row="0"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,0">
                            <StackPanel Margin="42,30,42,16"
                                        MaxWidth="760"
                                        HorizontalAlignment="Left">
                                <TextBlock Text="Сборки"
                                           Foreground="White"
                                           FontSize="34"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Управление доступными сборками из launcher-config.json."
                                           Foreground="#B8C2D1"
                                           FontSize="16"
                                           Margin="0,10,0,24"/>

                                <Border Background="#B8121925"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="22,18">
                                    <StackPanel>
                                        <TextBlock Text="Доступные сборки"
                                                   Foreground="#FFFFFF"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,14"/>
                                        <ItemsControl x:Name="BuildsListControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1A2333"
                                                            BorderBrush="#313A4A"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="16"
                                                            Margin="0,0,0,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="White"
                                                                           FontSize="18"
                                                                           FontWeight="SemiBold"/>
                                                                <TextBlock Foreground="#AAB4C3"
                                                                           FontSize="13"
                                                                           Margin="0,6,0,0">
                                                                    <Run Text="Minecraft "/>
                                                                    <Run Text="{Binding MinecraftVersion}"/>
                                                                    <Run Text=" • версия "/>
                                                                    <Run Text="{Binding Version}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding VersionId}"
                                                                       Foreground="#20D6AA"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="NewsView"
                                      Grid.Row="0"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="42,30,42,16"
                                        MaxWidth="760"
                                        HorizontalAlignment="Left">
                                <TextBlock Text="Новости"
                                           Foreground="White"
                                           FontSize="34"
                                           FontWeight="Bold"/>
                                <Border Background="#B8121925"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="22,18"
                                        Margin="0,24,0,0">
                                    <TextBlock Text="Новостей пока нет."
                                               Foreground="#B8C2D1"
                                               FontSize="16"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="SettingsView"
                                      Grid.Row="0"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="42,30,42,16"
                                        MaxWidth="760"
                                        HorizontalAlignment="Left">
                                <TextBlock Text="Настройки"
                                           Foreground="White"
                                           FontSize="34"
                                           FontWeight="Bold"/>
                                <Border Background="#B8121925"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="22,18"
                                        Margin="0,24,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Папки лаунчера"
                                                   Foreground="#FFFFFF"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LauncherFolderText"
                                                   Foreground="#B8C2D1"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="ProfileView"
                                      Grid.Row="0"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="42,30,42,16"
                                        MaxWidth="760"
                                        HorizontalAlignment="Left">
                                <TextBlock Text="Профиль"
                                           Foreground="White"
                                           FontSize="34"
                                           FontWeight="Bold"/>
                                <Border Background="#B8121925"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="22,18"
                                        Margin="0,24,0,0">
                                    <TextBlock Text="Профиль игрока пока не настроен."
                                               Foreground="#B8C2D1"
                                               FontSize="16"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="AboutView"
                                      Grid.Row="0"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="42,30,42,16"
                                        MaxWidth="760"
                                        HorizontalAlignment="Left">
                                <TextBlock Text="О программе"
                                           Foreground="White"
                                           FontSize="34"
                                           FontWeight="Bold"/>
                                <Border Background="#B8121925"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="22,18"
                                        Margin="0,24,0,0">
                                    <StackPanel>
                                        <TextBlock Text="BCLauncher"
                                                   Foreground="White"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Лаунчер для установки и запуска сборок BazarCraft через TLauncher."
                                                   Foreground="#B8C2D1"
                                                   FontSize="15"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,0"/>
                                        <TextBlock Text="v1.0.0"
                                                   Foreground="#20D6AA"
                                                   FontSize="14"
                                                   Margin="0,18,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid x:Name="ActionBar"
                              Grid.Row="1"
                              Panel.ZIndex="10"
                              Margin="42,0,22,18">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button x:Name="InstallUpdateButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="230"
                                        Margin="0,0,14,0"
                                        Click="DownloadButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⇩"
                                                   FontSize="22"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="Установить / Обновить"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="PlayButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="230"
                                        Click="PlayButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▷"
                                                   FontSize="25"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="Играть"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
